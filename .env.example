# MinIO (S3) Credentials
MINIO_ACCESS_KEY=your_minio_user_here
MINIO_SECRET_KEY=your_minio_password_here
# Internal S3 API (Docker: http://minio:9000). Optional on host; train.py defaults to http://localhost:9000.
MINIO_ENDPOINT=http://minio:9000
# Host:port in presigned download URLs for browsers / your laptop (same MinIO, reachable from outside the stack).
# Example on the host: http://127.0.0.1:9000
MINIO_PUBLIC_URL=http://127.0.0.1:9000
# Presigned GET lifetime in seconds (default 86400 = 24h)
MINIO_PRESIGNED_EXPIRES=86400

# MLflow tracking (optional on host; defaults to http://localhost:5000 in src/ml/train.py)
MLFLOW_TRACKING_URI=http://localhost:5000
# Boto / MLflow S3 artifact store (same MinIO as above; on host e.g. http://127.0.0.1:9000)
AWS_ACCESS_KEY_ID=your_minio_user_here
AWS_SECRET_ACCESS_KEY=your_minio_password_here
MLFLOW_S3_ENDPOINT_URL=http://127.0.0.1:9000

# Optional: host path to uv's cache when building the Airflow image (docker-compose additional_contexts).
# Example: /home/you/.cache/uv — seeds the BuildKit cache from local wheels/sources.
# UV_CACHE_HOST=

# PostgreSQL Credentials
POSTGRES_USER=your_db_user_here
POSTGRES_PASSWORD=your_db_password_here
# Connection URL for app code (tickers table lives in ml_data)
# In Docker: postgresql://<user>:<pass>@postgres:5432/ml_data
# On host:   postgresql://<user>:<pass>@localhost:5432/ml_data
DATABASE_URL=postgresql://your_db_user_here:your_db_password_here@localhost:5432/ml_data

API_BASE_URL=http://api:8000
# Airflow — generate Fernet with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW_WEBSERVER_SECRET_KEY=your_webserver_secret_here
AIRFLOW_JWT_SECRET=your_jwt_secret_here
AIRFLOW_INTERNAL_API_SECRET_KEY=your_internal_api_secret_here
AIRFLOW_SIMPLE_AUTH_MANAGER_USERS=admin:changeme
AIRFLOW_WWW_USER_PASSWORD=changeme