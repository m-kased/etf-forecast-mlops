# MinIO (S3) Credentials
MINIO_ACCESS_KEY=your_minio_user_here
MINIO_SECRET_KEY=your_minio_password_here
# Internal S3 API (Docker: http://minio:9000). Used for uploads from Airflow.
MINIO_ENDPOINT=http://minio:9000
# Host:port in presigned download URLs for browsers / your laptop (same MinIO, reachable from outside the stack).
# Example on the host: http://127.0.0.1:9000
MINIO_PUBLIC_URL=http://127.0.0.1:9000
# Presigned GET lifetime in seconds (default 86400 = 24h)
MINIO_PRESIGNED_EXPIRES=86400

# PostgreSQL Credentials
POSTGRES_USER=your_db_user_here
POSTGRES_PASSWORD=your_db_password_here

# Airflow — generate Fernet with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW_WEBSERVER_SECRET_KEY=your_webserver_secret_here
AIRFLOW_JWT_SECRET=your_jwt_secret_here
AIRFLOW_INTERNAL_API_SECRET_KEY=your_internal_api_secret_here
AIRFLOW_SIMPLE_AUTH_MANAGER_USERS=admin:changeme
AIRFLOW_WWW_USER_PASSWORD=changeme